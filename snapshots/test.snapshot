cli-test:  (type=dir)
	.github:  (type=dir)
		ISSUE_TEMPLATE:  (type=dir)
			bug_report.yml:  (type=file)
				---
				name: Bug Report
				description: "Submit a bug for the latest version"
				title: "YOUR DESCRIPTIVE TITLE GOES HERE"
				labels: ["bug", "triage"]
				body:
				  - type: checkboxes
				    id: checks
				    attributes:
				      label: First Check
				      description: |
				        Please confirm and check all the following prior to submission. If you do not do this, your
				        issue may be closed.
				      options:
				        - label: This is not a feature request.
				          required: true
				        - label: I added a very descriptive title to this issue (title field is above this).
				          required: true
				        - label: I used the GitHub search to find a similar issue and didn't find it.
				          required: true
				  - type: textarea
				    id: description
				    attributes:
				      label: What is the issue you are experiencing?
				      placeholder: A clear and concise description of what the bug is.
				    validations:
				      required: true
				  - type: textarea
				    id: reproduction
				    attributes:
				      label: Steps to Reproduce (or failing test case)
				      placeholder: 1) ... 2) ... 3) ...
				    validations:
				      required: true
				  - type: textarea
				    id: version
				    attributes:
				      label: Package Version
				      placeholder: e.g. v0.1.1
				
			feature_request.yml:  (type=file)
				name: Feature Request
				description: "Submit a new feature request"
				title: "YOUR DESCRIPTIVE TITLE GOES HERE"
				labels: ["feature", "triage"]
				body:
				  - type: checkboxes
				    id: checks
				    attributes:
				      label: First Check
				      description: |
				        Please confirm and check all the following prior to submission. If you do not do this, your
				        issue may be closed.
				      options:
				        - label: I used the GitHub search to find a similar requests and didn't find it.
				          required: true
				  - type: textarea
				    id: problem
				    attributes:
				      label: Please provide a concise description of the problem that would be addressed by this feature.
				    validations:
				      required: true
				  - type: textarea
				    id: solution
				    attributes:
				      label: Please provide a concise description of the feature that would resolve your issue.
				    validations:
				      required: true
				  - type: textarea
				    id: considerations
				    attributes:
				      label: Please consider and list out some caveats or tradeoffs made in your design decision
				    validations:
				      required: true
				  - type: checkboxes
				    id: additional-information
				    attributes:
				      label: Additional Information
				      options:
				        - label: If this is accepted I'm willing to submit a PR to provide this feature
				        - label: If this is accepted I'm willing to help maintain this feature
				
		PULL_REQUEST_TEMPLATE.md:  (type=file)
			Fixes #
			
			## Purpose
			
			## Proposed Changes
			
			  -
			  -
			  -
			
			## Checklist
			
			- [ ] I have added tests that prove my fix is effective or that my feature works
			- [ ] I have added necessary documentation (if appropriate)
		workflows:  (type=dir)
			partial-tests.yml:  (type=file)
				name: Rust Build/Test
				
				on:
				  workflow_call:
				
				jobs:
				  Rust:
				    runs-on: ubuntu-latest
				    steps:
				      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
				
				      - name: Install tools
				        uses: jdx/mise-action@924e7c586e33d7d4bae9c14e26c5d22e2beb6e78 # v5.3.0
				
				      - name: Cache cargo
				        uses: Swatinem/rust-cache@d1527c8f67ef9af357290475d4af4b0fab8f12e0 # v2.9.3
				
				      - name: Check
				        run: mise run check
				
			pr.yml:  (type=file)
				name: pr
				
				on:
				  push:
				    branches:
				      - main
				  pull_request:
				    branches:
				      - main
				
				jobs:
				  backend-tests:
				    name: "Rust Build/Test"
				    uses: ./.github/workflows/partial-tests.yml
				
			publish.yml:  (type=file)
				name: Build and Publish
				
				permissions:
				  contents: write # for release
				  packages: write
				
				on:
				  workflow_dispatch:
				    inputs:
				      semverbump:
				        description: "Which version to bump by"
				        required: true
				        default: "patch"
				        type: choice
				        options:
				          - patch
				          - minor
				          - major
				
				jobs:
				  backend-tests:
				    name: "Rust Build/Test"
				    uses: ./.github/workflows/partial-tests.yml
				
				  tag:
				    name: "Publish Tag"
				    runs-on: ubuntu-latest
				    needs:
				      - backend-tests
				    steps:
				      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
				
				      - uses: actions-ecosystem/action-get-latest-tag@b7c32daec3395a9616f88548363a42652b22d435 # v1.6.0
				        id: get-latest-tag
				
				      - uses: actions-ecosystem/action-bump-semver@34e334551143a5301f38c830e44a22273c6ff5c5 # v1.0.0
				        id: bump-semver
				        with:
				          current_version: ${{ steps.get-latest-tag.outputs.tag }}
				          level: ${{ inputs.semverbump }}
				
				      - uses: actions-ecosystem/action-push-tag@6e82caefe706f5a729e354df7443dc82f98a414f # v1.0.0
				        with:
				          tag: ${{ steps.bump-semver.outputs.new_version }}
				          message: "${{ steps.bump-semver.outputs.new_version }}"
				
				  goreleaser:
				    name: "Release"
				    needs:
				      - backend-tests
				      - tag
				    runs-on: ubuntu-latest
				    steps:
				      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
				        with:
				          fetch-depth: 0
				      - run: git fetch --force --tags
				
				      - name: Install tools
				        uses: jdx/mise-action@924e7c586e33d7d4bae9c14e26c5d22e2beb6e78 # v5.3.0
				
				      - name: Cache cargo
				        uses: Swatinem/rust-cache@d1527c8f67ef9af357290475d4af4b0fab8f12e0 # v2.9.3
				
				      - uses: docker/setup-buildx-action@f87e5991a6d7451dcb8d9637bfbc97413f497069 # v4.4.1
				
				      - uses: docker/login-action@8aa5831fb8d48d8f76594c7ddde61ae58019f550 # v4.8.0
				        with:
				          registry: ghcr.io
				          username: ${{ github.actor }}
				          password: ${{ secrets.GITHUB_TOKEN }}
				
				      - name: Release
				        run: goreleaser release --clean
				        env:
				          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
				          HOMEBREW_TAP_GITHUB_TOKEN: ${{ secrets.HOMEBREW_TAP_GITHUB_TOKEN }}
				
	.gitignore:  (type=file)
		/target
		/dist
		*.profraw
		lcov.info
		*.snap.new
		*.pending-snap
		
	.goreleaser.yml:  (type=file)
		# yaml-language-server: $schema=https://goreleaser.com/static/schema.json
		version: 2
		project_name: cli-test
		
		before:
		  hooks:
		    - rustup target add x86_64-unknown-linux-musl aarch64-unknown-linux-musl x86_64-apple-darwin aarch64-apple-darwin x86_64-pc-windows-gnu
		
		builds:
		  # cargo-zigbuild cross-compiles every target from one host, with zig as the
		  # C compiler and linker. Linux builds are static musl binaries.
		  - id: cli-test
		    builder: rust
		    command: zigbuild
		    binary: cli-test
		    flags:
		      - --release
		      - --locked
		    targets:
		      - x86_64-unknown-linux-musl
		      - aarch64-unknown-linux-musl
		      - x86_64-apple-darwin
		      - aarch64-apple-darwin
		      - x86_64-pc-windows-gnu
		    env:
		      - BUILD_VERSION={{ .Version }}
		      - BUILD_COMMIT={{ .FullCommit }}
		      - BUILD_DATE={{ .Date }}
		
		archives:
		  - formats: [tar.gz]
		    # this name template makes the OS and Arch compatible with the results of uname.
		    name_template: >-
		      {{ .ProjectName }}_
		      {{- title .Os }}_
		      {{- if eq .Arch "amd64" }}x86_64
		      {{- else if eq .Arch "386" }}i386
		      {{- else }}{{ .Arch }}{{ end }}
		    # use zip for windows archives
		    format_overrides:
		      - goos: windows
		        formats: [zip]
		
		checksum:
		  name_template: "checksums.txt"
		
		snapshot:
		  version_template: "{{ incpatch .Version }}-next"
		
		changelog:
		  sort: asc
		  groups:
		    - title: Features
		      regexp: '^.*?feat(\(\w+\))??!?:.+$'
		      order: 0
		    - title: Bug Fixes
		      regexp: '^.*?fix(\(\w+\))??!?:.+$'
		      order: 1
		    - title: Documentation
		      regexp: '^.*?docs(\(\w+\))??!?:.+$'
		      order: 2
		    - title: Other
		      order: 999
		  filters:
		    exclude:
		      - "^test:"
		      - "^chore:"
		      - "^ci:"
		
		homebrew_casks:
		  - repository:
		      owner: "hay-kot"
		      name: "homebrew-scaffold-rust-cli-tap"
		      token: "{{ .Env.HOMEBREW_TAP_GITHUB_TOKEN }}"
		    description: "A new project"
		    homepage: "https://github.com/username/cli-test"
		
		dockers_v2:
		  - ids:
		      - cli-test
		    images:
		      - "ghcr.io/hay-kot/scaffold-rust-cli"
		    tags:
		      - "v{{ .Version }}"
		      - "latest"
		    platforms:
		      - linux/amd64
		      - linux/arm64
		    labels:
		      org.opencontainers.image.created: "{{ .Date }}"
		      org.opencontainers.image.title: "{{ .ProjectName }}"
		      org.opencontainers.image.revision: "{{ .FullCommit }}"
		      org.opencontainers.image.version: "v{{ .Version }}"
		
		
	.scaffold:  (type=dir)
		command:  (type=dir)
			hooks:  (type=dir)
				post_scaffold.sh:  (type=file)
					#!/usr/bin/env bash
					# rustfmt sorts the injected `mod` declaration into place.
					set -euo pipefail
					cargo fmt --all
					
			scaffold.yaml:  (type=file)
				# yaml-language-server: $schema=https://hay-kot.github.io/scaffold/schema.json
				questions:
				  - name: "command_name"
				    prompt:
				      message: "Command Name"
				      description: "kebab-case command name"
				    validate:
				      required: true
				      match:
				        regex: "^[a-z]+(-[a-z]+)*$"
				        message: "must be kebab-case"
				
				rewrites:
				  - from: templates/src/commands/command.rs
				    to: "src/commands/{{ .Scaffold.command_name | toSnakeCase }}.rs"
				
				inject:
				  - name: "declare module"
				    path: src/commands.rs
				    at: "// +scaffold:command:module"
				    mode: before
				    template: |
				      pub(crate) mod {{ .Scaffold.command_name | toSnakeCase }};
				  - name: "add subcommand"
				    path: src/cli.rs
				    at: "// +scaffold:command:variant"
				    mode: before
				    template: |
				      /// Run the {{ .Scaffold.command_name }} command
				      {{ .Scaffold.command_name | toPascalCase }}(commands::{{ .Scaffold.command_name | toSnakeCase }}::Args),
				  - name: "dispatch subcommand"
				    path: src/main.rs
				    at: "// +scaffold:command:dispatch"
				    mode: before
				    template: |
				      Command::{{ .Scaffold.command_name | toPascalCase }}(args) => commands::{{ .Scaffold.command_name | toSnakeCase }}::run(&args, &ctx, &mut out),
				
				presets:
				  default:
				    command_name: "example"
				
			templates:  (type=dir)
				src:  (type=dir)
					commands:  (type=dir)
						command.rs:  (type=file)
							//! The `{{ .Scaffold.command_name }}` command.
							
							use std::io::Write;
							
							use super::Context;
							
							#[derive(Debug, clap::Args)]
							pub(crate) struct Args;
							
							pub(crate) fn run(_args: &Args, _ctx: &Context, out: &mut impl Write) -> anyhow::Result<()> {
							    tracing::info!("running {{ .Scaffold.command_name }} command");
							
							    writeln!(out, "Hello World!")?;
							    Ok(())
							}
							
							#[cfg(test)]
							mod tests {
							    use super::*;
							
							    #[test]
							    fn prints_greeting() {
							        let mut out = Vec::new();
							        run(&Args, &Context::default(), &mut out).unwrap();
							        insta::assert_snapshot!(String::from_utf8(out).unwrap(), @"Hello World!");
							    }
							}
							
	AGENTS.md:  (type=file)
		# AGENTS.md
		
		Guidance for coding agents working in this repository.
		
		## Before you finish
		
		Run `mise run check`. It is what CI runs, and it must pass: formatting, clippy with warnings as errors, tests, docs, cargo-deny, cargo-shear and typos.
		
		## Lints
		
		The lint set in `Cargo.toml` is strict on purpose. Fix the code rather than silencing the lint. When a lint is wrong for one spot, silence it there with a reason:
		
		```rust
		#[expect(clippy::cast_possible_truncation, reason = "value is checked to fit in u8 above")]
		```
		
		Never use `#[allow(...)]` (the `allow_attributes` lint rejects it), and never add a crate-level or `Cargo.toml` allow without asking.
		
		## Conventions
		
		- `main.rs` owns process concerns: parsing, logging setup, error reporting and the exit code. Commands never call `std::process::exit`.
		- Commands write output to the `out: &mut impl Write` they are given, never with `println!`. Logs go to stderr through `tracing`.
		- Library-style modules return `anyhow::Result` with context on every fallible call (`.with_context(|| ...)`). Use `thiserror` if a caller needs to match on error variants.
		- No `unwrap`, `expect` or `panic!` outside tests.
		- Add a command with `scaffold new command`, not by hand, so all registration points stay in sync.
		
		## Tests
		
		- Unit tests go in a `#[cfg(test)] mod tests` block in the same file. Integration tests that run the binary go in `tests/`.
		- Every new command gets a unit test that captures its output and a CLI test in `tests/cli.rs`.
		- Use `insta::assert_snapshot!` for multi-line or structured output, and `cargo insta review` to accept intended changes.
		
	CLAUDE.md:  (type=file)
		@AGENTS.md
		
	Cargo.toml:  (type=file)
		[package]
		name = "cli-test"
		version = "0.1.0"
		edition = "2024"
		rust-version = "1.100"
		description = "A new project"
		authors = ["John Doe"]
		license = "MIT"
		repository = "https://github.com/username/cli-test"
		readme = "README.md"
		keywords = ["cli"]
		categories = ["command-line-utilities"]
		# Releases ship as binaries through GoReleaser, not through crates.io.
		publish = false
		
		[dependencies]
		anyhow = "1"
		clap = { version = "4", features = ["derive", "env", "string", "wrap_help"] }
		clap_complete = "4"
		tracing = "0.1"
		tracing-subscriber = "0.3"
		
		[dev-dependencies]
		assert_cmd = "2"
		insta = "1"
		predicates = "3"
		
		[profile.release]
		codegen-units = 1
		lto = "thin"
		strip = true
		
		# The lint set is strict on purpose: it keeps generated and hand-written code
		# to the same bar. Silence a lint at the use site with
		# `#[expect(clippy::name, reason = "...")]`, never with a blanket allow here.
		[lints.rust]
		unsafe_code = "forbid"
		let_underscore_drop = "warn"
		missing_debug_implementations = "warn"
		rust_2018_idioms = { level = "warn", priority = -1 }
		unreachable_pub = "warn"
		unused_lifetimes = "warn"
		unused_qualifications = "warn"
		
		[lints.clippy]
		cargo = { level = "warn", priority = -1 }
		nursery = { level = "warn", priority = -1 }
		pedantic = { level = "warn", priority = -1 }
		
		# Transitive dependencies often pull two versions of one crate; cargo-deny
		# reports duplicates instead.
		multiple_crate_versions = "allow"
		# Conflicts with rustc's `unreachable_pub`, which this crate keeps instead.
		redundant_pub_crate = "allow"
		
		# Selected restriction lints.
		allow_attributes = "warn"
		allow_attributes_without_reason = "warn"
		as_conversions = "warn"
		clone_on_ref_ptr = "warn"
		create_dir = "warn"
		dbg_macro = "warn"
		empty_structs_with_brackets = "warn"
		exit = "warn"
		expect_used = "warn"
		filetype_is_file = "warn"
		format_push_string = "warn"
		get_unwrap = "warn"
		if_then_some_else_none = "warn"
		indexing_slicing = "warn"
		infinite_loop = "warn"
		let_underscore_must_use = "warn"
		lossy_float_literal = "warn"
		mem_forget = "warn"
		missing_assert_message = "warn"
		mod_module_files = "warn"
		panic = "warn"
		print_stderr = "warn"
		print_stdout = "warn"
		rc_buffer = "warn"
		redundant_type_annotations = "warn"
		rest_pat_in_fully_bound_structs = "warn"
		same_name_method = "warn"
		shadow_unrelated = "warn"
		str_to_string = "warn"
		string_add = "warn"
		string_slice = "warn"
		tests_outside_test_module = "warn"
		todo = "warn"
		undocumented_unsafe_blocks = "warn"
		unimplemented = "warn"
		unneeded_field_pattern = "warn"
		unused_result_ok = "warn"
		unwrap_in_result = "warn"
		unwrap_used = "warn"
		verbose_file_reads = "warn"
		wildcard_enum_match_arm = "warn"
		
	Dockerfile:  (type=file)
		# GoReleaser builds static musl binaries outside Docker and places them at
		# <os>/<arch>/cli-test in the build context.
		FROM gcr.io/distroless/static-debian12:nonroot
		ARG TARGETPLATFORM
		COPY ${TARGETPLATFORM}/cli-test /usr/local/bin/cli-test
		ENTRYPOINT ["/usr/local/bin/cli-test"]
		
	HOMEBREW_SETUP.md:  (type=file)
		# Homebrew Tap Setup
		
		This project is configured to publish to a Homebrew tap via GoReleaser. Follow these steps to set it up.
		
		## 1. Create the Tap Repository
		
		Create a new GitHub repository named `homebrew-scaffold-rust-cli-tap` under the `hay-kot` account. This repository will hold the Homebrew cask definitions that GoReleaser publishes.
		
		## 2. Generate a Personal Access Token (PAT)
		
		GoReleaser needs a PAT with write access to the tap repository (separate from `GITHUB_TOKEN` which is scoped to the source repo).
		
		1. Go to **GitHub Settings > Developer Settings > Personal Access Tokens > Fine-grained tokens**
		2. Create a new token with:
		   - **Repository access**: Select the `homebrew-scaffold-rust-cli-tap` repository
		   - **Permissions**: Contents (Read and write)
		3. Copy the generated token
		
		## 3. Add the Secret to Your Source Repository
		
		1. Go to your source repository **Settings > Secrets and variables > Actions**
		2. Click **New repository secret**
		3. Name: `HOMEBREW_TAP_GITHUB_TOKEN`
		4. Value: Paste the PAT from the previous step
		
		## 4. Verify
		
		After the next release, GoReleaser will push a cask definition to your tap repository. Users can then install with:
		
		```sh
		brew tap hay-kot/scaffold-rust-cli-tap
		brew install cli-test
		```
		
		## References
		
		- [GoReleaser Homebrew Casks](https://goreleaser.com/customization/homebrew_casks/)
		
